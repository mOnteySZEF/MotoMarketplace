<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".DodajActivity">

    <TextView
        android:id="@+id/tvNaglowek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/granat"
        android:padding="16dp"
        android:text="Dodaj ogłoszenie"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marka"
                android:textColor="@color/granat"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etMarka"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="np. BMW"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Model"
                android:textColor="@color/granat"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="np. 330i"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Rok produkcji"
                android:textColor="@color/granat"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etRok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="np. 2022"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Przebieg (km)"
                android:textColor="@color/granat"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etPrzebieg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="np. 30000"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Rodzaj paliwa"
                android:textColor="@color/granat"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/spPaliwo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/paliwa" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Skrzynia biegów"
                android:textColor="@color/granat"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rgSkrzynia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbManualna"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manualna" />

                <RadioButton
                    android:id="@+id/rbAutomatyczna"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:checked="true"
                    android:text="Automatyczna" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Cena (zł)"
                android:textColor="@color/granat"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etCena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="np. 200000"
                android:inputType="number" />

            <Button
                android:id="@+id/btnZapisz"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/pomarancz"
                android:text="Dodaj ogłoszenie"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnAnuluj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/szary"
                android:text="Anuluj" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
