<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/baseline_directions_car_24"
        app:tint="@color/pomarancz" />

    <TextView
        android:id="@+id/tvTytul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MotoMarket"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWitaj"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Witaj! Kup lub sprzedaj swoje autko"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnOgloszenia"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Przeglądaj ogłoszenia" />

    <Button
        android:id="@+id/btnDodaj"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Dodaj ogłoszenie" />

</LinearLayout>
