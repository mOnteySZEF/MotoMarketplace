<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tlo"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/baseline_directions_car_24"
        app:tint="@color/pomarancz" />

    <TextView
        android:id="@+id/tvTytul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MotoMarket"
        android:textColor="@color/granat"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWitaj"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Witaj! Kup lub sprzedaj swoje autko"
        android:textColor="@color/szary"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnOgloszenia"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="32dp"
        android:backgroundTint="@color/pomarancz"
        android:text="Przeglądaj ogłoszenia"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnDodaj"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:backgroundTint="@color/granat"
        android:text="Dodaj ogłoszenie"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvWersja"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="wersja 1.0"
        android:textColor="@color/szary"
        android:textSize="14sp" />

</LinearLayout>
